# 파이썬
__pycache__/
*.pyc
.venv/
venv/

# 생성물 (코드로 다시 만들 수 있으므로 git에 올리지 않습니다)
output/charts/*.png

# 에디터
.vscode/
.idea/
.DS_Store

# ===========================================================================
# 원시 데이터 (절대 공개 저장소에 올리지 않습니다)
# ===========================================================================
# K리그 데이터포털 이용약관 제4조:
#   연맹의 사전 승낙 없는 복제 / 출판 / 제3자 제공 / 상업적 이용 금지.
#
# GitHub 공개 저장소에 CSV를 올리는 것은 '제3자 제공'에 해당할 수 있습니다.
# 공개해도 되는 것은 '가공된 결과물'(차트, 집계표)이지 원시 기록이 아닙니다.
#
# 백업이 걱정된다면 git이 아니라 다른 곳에 두세요.
#   예) OneDrive / Google Drive 동기화 폴더, 외장 USB
#   git은 '코드 관리' 도구이지 '데이터 백업' 도구가 아닙니다.
data/raw/

# ---------------------------------------------------------------------------
# site/data/ 는 GitHub Pages가 읽어야 하므로 올립니다.
#
# 다만 주의: export.py 가 경기별·선수별 '원시 행'을 그대로 담으면
#            형식만 JSON일 뿐 원시 데이터를 공개하는 것과 같습니다.
#            실제 데이터를 넣기 전에 집계값만 담도록 손봐야 합니다.
#            (지금은 샘플 데이터라 문제되지 않습니다)
# ---------------------------------------------------------------------------

# 편집 중 만든 백업
*.bak

# 원고 초안 (발행 전에는 공개하지 않습니다)
posts/
